rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing collections ──
    match /solicitudes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Campaigns (public read, auth create, owner update) ──
    match /campanas/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.creadorUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.creadorUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creadorUid;
    }

    // ── Chat messages ──
    match /chat_messages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    // ── Typing indicator ──
    match /chat_typing/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Feed posts ──
    match /posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    // ── Reports ──
    match /reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reportedBy;
      allow delete: if false;
    }
  }
}
